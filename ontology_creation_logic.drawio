        <mxCell id="base-assemble" value="&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:10px;&quot;&gt;CODE • GHÉP SCHEMA + PROPOSAL&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;Giữ IDs và thông tin vật lý; ghép tên / mô tả.&lt;br/&gt;Kiểm tra đủ cột và logic Methods trong một bảng.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1E3A8A;strokeWidth=1.5;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage2">
