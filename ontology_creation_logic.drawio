        </mxCell>
        <mxCell id="relation-prompt" value="CHUẨN BỊ PROMPT • MÔ TẢ RELATIONS" style="shape=swimlane;html=1;horizontal=1;startSize=44;rounded=1;arcSize=8;fillColor=#DBEAFE;swimlaneFillColor=#F8FBFF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Arial;fontSize=18;fontStyle=1;align=left;spacingLeft=16;collapsible=0;container=1;recursiveResize=0;" vertex="1" parent="stage4">
          <mxGeometry x="25" y="260" width="650" height="625" as="geometry" />
        </mxCell>
        <mxCell id="relation-context" value="&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:10px;&quot;&gt;A. CONTEXT ĐẦU VÀO&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;• Class / Properties hiện tại và tham chiếu trực tiếp.&lt;br/&gt;• &lt;b&gt;FK được giao cho bảng sở hữu hiện tại.&lt;/b&gt;&lt;br/&gt;• Khung Relation: endpoints và cardinality từ code.&lt;br/&gt;&lt;b&gt;Context:&lt;/b&gt; FK vào / ra / self. &lt;b&gt;Sinh:&lt;/b&gt; chỉ FK được giao.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;strokeWidth=1.5;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="relation-prompt">
