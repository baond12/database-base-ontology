        <mxCell id="structure-note" value="&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:10px;&quot;&gt;CẤU TRÚC ĐƯỢC GIỮ CỐ ĐỊNH&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;Code giữ thông tin vật lý và IDs.&lt;br/&gt;LLM bổ sung diễn giải, không quyết định bảng / cột / FK mới.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;dashed=1;dashPattern=5 4;" vertex="1" parent="stage1">
