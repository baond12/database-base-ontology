        <mxCell id="base-prompt" value="CHUẨN BỊ PROMPT • BASE ONTOLOGY" style="shape=swimlane;html=1;horizontal=1;startSize=44;rounded=1;arcSize=8;fillColor=#DBEAFE;swimlaneFillColor=#F8FBFF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Arial;fontSize=18;fontStyle=1;align=left;spacingLeft=16;collapsible=0;container=1;recursiveResize=0;" vertex="1" parent="stage2">
