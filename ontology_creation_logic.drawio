        <mxCell id="build-context" value="&lt;div style=&quot;font-size:19px;font-weight:700;margin-bottom:10px;&quot;&gt;CODE • GHÉP CONTEXT 1 BƯỚC&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;Class / Properties hiện tại&lt;br/&gt;&lt;b&gt;+&lt;/b&gt; Class / Properties liên kết trực tiếp&lt;br/&gt;&lt;b&gt;Incoming FK • Outgoing FK • Self-FK&lt;/b&gt;&lt;br/&gt;Chọn láng giềng từ các FK trong schema&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1E3A8A;strokeWidth=1.5;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage3">
          <mxGeometry x="25" y="395" width="370" height="220" as="geometry" />
        </mxCell>
        <mxCell id="reference-context" value="&lt;div style=&quot;font-size:19px;font-weight:700;margin-bottom:10px;&quot;&gt;CONTEXT CHO TỪNG CLASS&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;Class / Properties hiện tại&lt;br/&gt;Các Class / Properties tham chiếu&lt;br/&gt;Danh sách FK liên quan&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontColor=#065F46;strokeWidth=1.5;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage3">
          <mxGeometry x="25" y="740" width="370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="context-scope-note" value="&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:10px;&quot;&gt;PHẠM VI CONTEXT&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;&lt;b&gt;Chỉ 1 bước&lt;/b&gt; • Không đệ quy&lt;br/&gt;Giữ self-FK; không tự lặp Class trong láng giềng.&lt;br/&gt;Methods vẫn ở Class sở hữu; context mô tả Relations chỉ mang Class / Properties.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;dashed=1;dashPattern=5 4;" vertex="1" parent="stage3">
          <mxGeometry x="25" y="1050" width="370" height="200" as="geometry" />
        </mxCell>
        <mxCell id="physical-relation" value="&lt;div style=&quot;font-size:19px;font-weight:700;margin-bottom:10px;&quot;&gt;CODE • KHUNG RELATION TỪ SCHEMA&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;&lt;b&gt;Source / target Class + Properties&lt;/b&gt;&lt;br/&gt;Cardinality từ FK, Nullable, PK / UNIQUE toàn bảng&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1E3A8A;strokeWidth=1.5;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage4">
