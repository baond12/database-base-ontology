        <mxCell id="base-llm" value="&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:10px;&quot;&gt;LLM • ĐỀ XUẤT NGỮ NGHĨA&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;Tên / mô tả và kế hoạch Methods&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;fontColor=#6B21A8;strokeWidth=1.5;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage2">
          <mxGeometry x="85" y="890" width="480" height="85" as="geometry" />
