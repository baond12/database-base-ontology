        <mxCell id="bases" value="&lt;div style=&quot;font-size:19px;font-weight:700;margin-bottom:10px;&quot;&gt;BASE ONTOLOGIES&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;Mỗi bảng có Class + Properties + Methods&lt;br/&gt;&lt;b&gt;Lặp cho từng bảng → hoàn thành toàn bộ bảng&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontColor=#065F46;strokeWidth=1.5;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage2">
          <mxGeometry x="50" y="1330" width="550" height="100" as="geometry" />
