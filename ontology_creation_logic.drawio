        <mxCell id="base-proposal" value="&lt;div style=&quot;font-size:19px;font-weight:700;margin-bottom:10px;&quot;&gt;PROPOSAL CHO MỘT BẢNG&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;&lt;b&gt;Class + Properties + Methods&lt;/b&gt;&lt;br/&gt;Kèm assumptions và confidence&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontColor=#065F46;strokeWidth=1.5;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage2">
