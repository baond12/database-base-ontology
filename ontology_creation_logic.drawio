        </mxCell>
        <mxCell id="all-bases" value="&lt;div style=&quot;font-size:19px;font-weight:700;margin-bottom:10px;&quot;&gt;TOÀN BỘ BASE ONTOLOGIES&lt;/div&gt;&lt;div style=&quot;line-height:1.38;&quot;&gt;Đã có ontology của mọi bảng&lt;br/&gt;Giữ Methods tại Class sở hữu&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;strokeWidth=1.5;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;spacingTop=12;spacingBottom=12;" vertex="1" parent="stage3">
