{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["database_id", "class", "properties", "methods", "assumptions", "provenance"],
  "properties": {
    "database_id": {"type": "string"},
    "class": {"type": "object", "required": ["class_id", "name", "description", "source_table", "metadata_description", "confidence", "semantic_status"]},
    "properties": {"type": "array", "items": {"type": "object", "required": ["property_id", "name", "source_table", "source_column", "description", "data_type", "nullable", "primary_key_position", "is_foreign_key", "metadata_description", "confidence"]}},
    "methods": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["method_id", "owner_class_id", "name", "source_table", "scope", "status", "operation", "input_parameters", "output", "source_columns", "confidence"]}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "required": ["input_fingerprint", "generation_fingerprint", "llm", "trace_path"]}
  }
}
