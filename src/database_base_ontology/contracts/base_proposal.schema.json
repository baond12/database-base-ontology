{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["class_name", "description", "confidence", "properties", "methods", "assumptions"],
  "properties": {
    "class_name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
    "description": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "properties": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["column_name", "name", "description", "confidence"],
      "properties": {
        "column_name": {"type": "string"},
        "name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
        "description": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }},
    "methods": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "operation", "input_parameters", "output", "source_columns", "confidence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
        "description": {"type": "string", "minLength": 1},
        "operation": {"enum": ["list", "lookup", "count", "aggregate"]},
        "input_parameters": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "type", "required", "source_columns"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
            "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
            "required": {"type": "boolean"},
            "source_columns": {"$ref": "#/$defs/columns"}
          }
        }},
        "output": {"type": "object", "additionalProperties": false, "required": ["kind", "source_columns"],
          "properties": {"kind": {"enum": ["rows", "object", "scalar"]}, "source_columns": {"$ref": "#/$defs/columns"}}},
        "source_columns": {"$ref": "#/$defs/columns"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"columns": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
}
